<!DOCTYPE html>
<html>
<head>
  <title>EliteDrive - Cars</title>
</head>
<body>
<h1>Car Inventory</h1>

<table border="1">
  <thead>
  <tr>
    <th>Brand</th>
    <th>model</th>
    <th>Year</th>
    <th>Price</th>
  </tr>
  </thead>
  <tbody>
  {{#cars}}
  <tr>
    <td>{{brand}}</td>
    <td>{{model}}</td>
    <td>{{year}}</td>
    <td>${{price}}</td>
  </tr>
  {{/cars}}
  {{^cars}}
  <tr>
    <td colspan="4">No cars in inventory</td>
  </tr>
  {{/cars}}
  </tbody>
</table>

<br>
<a href="/cars/add">Add New Car</a>
<br>
<a href="/">Back to Home</a>
</body>
</html>