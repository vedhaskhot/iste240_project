<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>EliteDrive - Add Branch</title>
</head>
<body>
<h1>Add New Branch</h1>

<form action="/branches/add" method="post">
    Branch ID: <input type="text" name="branchID" required><br><br>
    City: <input type="text" name="city" required><br><br>
    Address: <input type="text" name="address" required><br><br>
    Branch Manager: <input type="text" name="branchManager"><br><br>
    <button type="submit">Add Branch</button>
</form>

<br>
<a href="/branches">Back to Branches</a>
<br>
<a href="/">Home</a>
</body>
</html>