<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>EliteDrive - New Application</title>
</head>
<body>
    <h1>Submit Membership Application</h1>

    <form action="/applications/add" method="post">
        <label>Application ID:</label>
        <input type="text" name="applicationId" required placeholder="e.g. AP1000"><br><br>

        <label>Applicant Name:</label>
        <input type="text" name="applicantName" required placeholder="Enter full name"><br><br>

        <label>Sponsor ID:</label>
        <input type="text" name="sponsorMemberId" placeholder="e.g. M001"><br><br>

        <button type="submit">Submit Application</button>
    </form>

    <br>
    <a href="/applications">Back to Applications</a>
    <br>
    <a href="/">Home</a>
</body>
</html>