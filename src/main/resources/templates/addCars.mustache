<!DOCTYPE html>
<html>
<head>
  <title>EliteDrive - Add Car</title>
</head>
<body>
<h1>Add New Car</h1>

<form action="/cars/add" method="post">
  <label>Brand:</label>
  <input type="text" name="brand" required placeholder="e.g. Toyota, Honda, Ford"><br><br>

  <label>model:</label>
  <input type="text" name="model" required placeholder="e.g. Camry, Civic, Mustang"><br><br>

  <label>Year:</label>
  <input type="number" name="year" required min="1900" max="2025"><br><br>

  <label>Price ($):</label>
  <input type="number" step="0.01" name="price" required min="0"><br><br>

  <!-- NO DROPDOWNS - Car is independent -->

  <button type="submit">Add Car</button>
</form>

<br>
<a href="/cars">Back to Cars</a>
<br>
<a href="/">Home</a>
</body>
</html>